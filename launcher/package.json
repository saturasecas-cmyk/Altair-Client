{
  "name": "altair-launcher",
  "version": "1.0.0",
  "description": "Launcher de Minecraft para Altair Client",
  "main": "main.js",
  "author": "Altair Client",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.altairclient.launcher",
    "productName": "Altair Launcher",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "versions.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AltairLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AltairLauncher-Portable-${version}.${ext}"
    },
    "compression": "maximum",
    "npmRebuild": false,
    "asar": true,
    "electronLanguages": [
      "en-US"
    ]
  }
}